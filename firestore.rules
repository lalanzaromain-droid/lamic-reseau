rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catalogues : lecture pour tous les authentifiés, écriture pour admins
    match /catalogues/{type} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Données magasin : users du magasin OU admin
    match /magasins/{magasinId}/{document=**} {
      allow read, write: if request.auth != null
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.magasinId == magasinId
         || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Inscriptions : écriture publique (formulaire), lecture/suppression admin only
    match /inscriptions/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users : chacun lit son propre doc, admin peut lire tous
    match /users/{uid} {
      allow read: if request.auth.uid == uid
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if request.auth.uid == uid;
    }
  }
}
